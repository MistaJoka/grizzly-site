---
import { getCollection } from 'astro:content';
import siteConfig from '../../site.config';
import PageLayout from '../layouts/PageLayout.astro';
import Container from '../components/primitives/Container.astro';
import { breadcrumbJsonLd } from '../lib/schema';
import { canonical } from '../lib/seo';
import { withBase } from '../lib/url';
import { GROUNDWORK_FIELDS as F, GROUNDWORK_LIMITS as L, HEARD_VIA, quoteActionUrl, quotePageUrl, smsHref } from '../lib/quote';

const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
const areas = (await getCollection('areas')).sort((a, b) => a.data.order - b.data.order);

const action = quoteActionUrl(siteConfig.quote.groundworkQuoteUrl);
const hostedPage = quotePageUrl(siteConfig.quote.groundworkQuoteUrl);
const { business } = siteConfig;
const textHref = smsHref(business.phoneHref);

const next = [
  { title: 'Alex reads your request', body: 'Every request goes to the owner, with any photos you attach.' },
  { title: 'You get a quote', body: 'Alex reviews the job and sends you a price for it.' },
  { title: 'The job gets scheduled', body: 'Alex is on site for the work, and the property is cleaned up after.' },
];

const jsonLd = breadcrumbJsonLd([
  { name: 'Home', url: canonical('/', Astro.site) },
  { name: 'Contact', url: canonical('/contact', Astro.site) },
]);

const field = 'mt-2 w-full rounded-xl border border-ink/15 bg-paper px-4 py-3 text-[length:var(--step-0)] transition-colors focus:border-moss focus:bg-paper-raised';
const label = 'block text-[length:var(--step--1)] font-semibold';
---
<PageLayout
  title="Request a quote."
  eyebrow="Contact"
  lede="Tell us what you need and where. Add a phone number or an email so Alex can reach you, and a photo if it helps."
  description="Request a quote from Grizzly Lawn Care for lawn maintenance, trimming, mulching, pressure washing, or tree and plant installation in Miami-Dade."
  jsonLd={jsonLd}
>
  <Container class="pb-24">
    <div class="grid gap-16 md:grid-cols-[3fr_2fr]">
      {action ? (
        <div class="rounded-[var(--radius-media)] bg-paper-raised p-6 shadow-[var(--shadow-panel)] md:p-10">
          <!--
            Plain multipart form, no JavaScript. It posts to the hosted Groundwork route (/r/<slug>/send),
            which saves the request and redirects the browser to the hosted confirmation page.
          -->
          <form
            id="quote-form"
            action={action}
            method="post"
            enctype="multipart/form-data"
            class="relative space-y-7"
            data-testid="quote-form"
          >
            <div>
              <label class={label} for="name">Your name</label>
              <input class={field} id="name" name={F.name} type="text" autocomplete="name" maxlength="120" required />
            </div>

            <div class="grid gap-7 sm:grid-cols-2">
              <div>
                <label class={label} for="phone">Phone</label>
                <input class={field} id="phone" name={F.phone} type="tel" autocomplete="tel" maxlength="40" />
              </div>
              <div>
                <label class={label} for="email">Email</label>
                <input class={field} id="email" name={F.email} type="email" autocomplete="email" maxlength="200" />
              </div>
            </div>
            <p class="-mt-3 text-[length:var(--step--1)] text-ink-muted">A phone number or an email is required.</p>

            <div class="grid gap-7 sm:grid-cols-2">
              <div>
                <label class={label} for="address">Address or neighborhood of the job</label>
                <input class={field} id="address" name={F.address} type="text" list="areas" autocomplete="street-address" maxlength="300" />
                <datalist id="areas">{areas.map((area) => <option value={area.data.town}></option>)}</datalist>
              </div>
              <div>
                <label class={label} for="service">What do you need?</label>
                <select class={field} id="service" name={F.service}>
                  <option value="">Choose one (optional)</option>
                  {services.map((service) => <option value={service.data.title}>{service.data.title}</option>)}
                  <option value="Something else">Something else</option>
                </select>
              </div>
            </div>

            <div>
              <label class={label} for="message">About the job</label>
              <textarea class={field} id="message" name={F.message} rows="6" maxlength="2000"></textarea>
            </div>

            <div>
              <label class={label} for="preferred_dates">Preferred dates (optional)</label>
              <input class={field} id="preferred_dates" name={F.preferredDates} type="text" maxlength="200" />
            </div>

            <div>
              <label class={label} for="heard_via">How did you hear about us? (optional)</label>
              <select class={field} id="heard_via" name={F.heardVia}>
                <option value="">Choose one</option>
                {HEARD_VIA.map(([value, text]) => <option value={value}>{text}</option>)}
              </select>
            </div>

            <div>
              <label class={label} for="photos">Photos (optional, up to {L.maxPhotos}, {L.maxPhotoMb} MB each)</label>
              <input class={`${field} file:mr-4 file:cursor-pointer file:rounded-full file:border-0 file:bg-canopy file:px-5 file:py-2 file:font-semibold file:text-paper hover:file:bg-moss`} id="photos" name={F.photos} type="file" multiple accept="image/jpeg,image/png,image/webp" />
            </div>

            <!-- Honeypot: Groundwork silently drops any request where this is filled. Off-screen, not display:none. -->
            <div class="absolute left-[-9999px] top-0" aria-hidden="true">
              <label for="website">Website</label>
              <input id="website" name={F.honeypot} type="text" tabindex="-1" autocomplete="off" />
            </div>

            <button
              type="submit"
              class="rounded-full bg-bloom px-8 py-4 text-[length:var(--step-0)] font-semibold text-paper-raised shadow-[0_0.75rem_1.75rem_-0.75rem_var(--bloom)] transition-colors duration-[var(--dur-fast)] hover:bg-bloom-deep"
            >
              Send request
            </button>
            <p class="text-[length:var(--step--1)] text-ink-muted">
              Your request is sent to a secure page that confirms it. Limit: {L.ratePerHour} requests per hour from one connection.
              Prefer the hosted form? <a class="text-moss underline underline-offset-4" href={hostedPage}>Open it here</a>.
            </p>
          </form>
        </div>
      ) : (
        <div data-testid="quote-unavailable" class="relative self-start overflow-hidden rounded-[var(--radius-media)] bg-paper-raised p-8 shadow-[var(--shadow-panel)] md:p-10">
          <div aria-hidden="true" class="stripes absolute inset-x-0 top-0 h-2"></div>
          <h2 class="text-[length:var(--step-2)]">The online quote form is being set up.</h2>
          <p class="mt-4 text-ink-muted">
            {business.phone || business.email
              ? 'In the meantime, call or email and describe the job.'
              : 'Please check back soon.'}
          </p>
        </div>
      )}

      <!-- Two stacked panels: what happens after sending, then where the work is done. -->
      <aside class="space-y-8 md:sticky md:top-28 md:self-start">
        <section aria-label="What happens next" class="relative overflow-hidden rounded-[var(--radius-media)] bg-canopy p-7 text-paper shadow-[var(--shadow-panel)] md:p-9">
          <div aria-hidden="true" class="stripes absolute inset-x-0 top-0 h-2 opacity-90"></div>
          {(business.phone || business.email) && (
            <div class="mb-8 border-b border-paper/15 pb-7">
              <h2 class="text-[length:var(--step--1)] font-semibold text-blade">Call or email</h2>
              {business.phone && business.phoneHref && (
                <a href={business.phoneHref} class="mt-3 block font-[family-name:var(--font-display)] text-[length:var(--step-3)] leading-none hover:text-blade">{business.phone}</a>
              )}
              {business.phone && textHref && (
                <a href={textHref} data-testid="text-link" class="mt-3 inline-block rounded-full border border-paper/30 px-5 py-2 font-semibold hover:border-paper">Text Alex</a>
              )}
              {business.email && <a href={`mailto:${business.email}`} class="mt-2 block text-paper/80 hover:text-paper">{business.email}</a>}
              {business.hours.length > 0 && (
                <ul class="mt-4 space-y-1 text-[length:var(--step--1)] text-paper/70">
                  {business.hours.map((line) => <li>{line}</li>)}
                </ul>
              )}
            </div>
          )}
          <h2 class="text-[length:var(--step-3)] leading-tight">What happens next</h2>
          <ol class="mt-6 space-y-5">
            {next.map((step, i) => (
              <li class="grid grid-cols-[2.25rem_1fr] gap-3">
                <span aria-hidden="true" class="font-[family-name:var(--font-display)] text-[length:var(--step-3)] leading-none text-blade">{i + 1}</span>
                <span>
                  <span class="block font-semibold">{step.title}</span>
                  <span class="mt-1 block text-[length:var(--step--1)] leading-relaxed text-paper/75">{step.body}</span>
                </span>
              </li>
            ))}
          </ol>
        </section>

        <section aria-label="Service area" class="rounded-[var(--radius-media)] border border-ink/10 bg-paper-raised p-7 shadow-[var(--shadow-panel)] md:mx-4 md:p-8">
          <h2 class="text-[length:var(--step-2)] leading-tight">Where we work</h2>
          <ul class="mt-5 flex flex-wrap gap-2.5">
            {areas.map((area) => (
              <li>
                <a href={withBase(`/areas/${area.id}`)} class="block rounded-full border border-ink/15 bg-paper px-4 py-2 text-[length:var(--step--1)] text-ink-muted transition-colors duration-[var(--dur-fast)] hover:border-moss hover:text-moss">{area.data.town}</a>
              </li>
            ))}
          </ul>
          <p class="mt-5 text-[length:var(--step--1)] text-ink-muted">And the neighborhoods around them in Miami-Dade.</p>
        </section>
      </aside>
    </div>
  </Container>
</PageLayout>
