---
import { getCollection } from 'astro:content';
import siteConfig, { credentialList } from '../../site.config';
import { withBase } from '../lib/url';
import PageLayout from '../layouts/PageLayout.astro';
import Container from '../components/primitives/Container.astro';
import Eyebrow from '../components/primitives/Eyebrow.astro';
import Button from '../components/primitives/Button.astro';
import ClosingCTA from '../components/sections/ClosingCTA.astro';
import { breadcrumbJsonLd } from '../lib/schema';
import { canonical } from '../lib/seo';

const featured = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order)[0];
const capabilities = [
  { title: 'Tree & plant installation', body: 'Container trees up to 25 gallons, staking, planting beds and mulch.' },
  { title: 'Commercial grounds maintenance', body: 'Mowing, edging, trimming and cleanup.' },
  { title: 'Bush & hedge trimming, mulching, pressure washing', body: 'Handled in the same visit as maintenance where it makes sense.' },
];
const why = [
  `${new Date().getFullYear() - siteConfig.business.foundedYear}+ years in continuous operation in Miami-Dade, under the same company name since ${siteConfig.business.foundedYear}`,
  'Owner on every job: one point of contact',
  'Hundreds of completed residential jobs',
  'On time, clean job sites, careful around irrigation',
];

const jsonLd = breadcrumbJsonLd([
  { name: 'Home', url: canonical('/', Astro.site) },
  { name: 'Commercial', url: canonical('/commercial', Astro.site) },
]);
---
<PageLayout
  title="Commercial installs and grounds maintenance."
  eyebrow="Commercial & HOA"
  lede="For general contractors, HOAs and property managers in Miami-Dade: tree and plant installs and grounds maintenance from an owner-operated company."
  description="Grizzly Lawn Care capability statement: tree and plant installation, commercial grounds maintenance, and credentials for contractors, HOAs and property managers in Miami-Dade."
  jsonLd={jsonLd}
>
  <section aria-label="Capabilities" class="bg-paper-raised py-20">
    <Container>
      <Eyebrow>What we do</Eyebrow>
      <ul class="mt-10 grid gap-8 md:grid-cols-3">
        {capabilities.map((item) => (
          <li class="reveal border-t border-stone pt-6">
            <h2 class="text-[length:var(--step-2)]">{item.title}</h2>
            <p class="mt-3 text-ink-muted">{item.body}</p>
          </li>
        ))}
      </ul>
    </Container>
  </section>

  {featured && (
    <section aria-label="Featured project" class="bg-paper py-20">
      <Container width="text">
        <Eyebrow>Featured project</Eyebrow>
        <h2 class="mt-4 text-[length:var(--step-3)]">{featured.data.title}</h2>
        <ul class="mt-6 divide-y divide-stone border-t border-stone">
          {featured.data.scope.map((item) => <li class="py-4 text-[length:var(--step-1)]">{item}</li>)}
        </ul>
        <p class="mt-6"><a href={withBase(`/work/${featured.id}`)} class="text-moss underline underline-offset-4">Project details</a></p>
      </Container>
    </section>
  )}

  <section aria-label="Why us" class="bg-paper-raised py-20">
    <Container width="text">
      <Eyebrow>Why us</Eyebrow>
      <ul class="mt-8 divide-y divide-stone border-t border-stone">
        {why.map((item) => <li class="py-4 text-[length:var(--step-1)]">{item}</li>)}
      </ul>
    </Container>
  </section>

  <section aria-label="Credentials" class="bg-paper py-20">
    <Container width="text">
      <Eyebrow>Credentials</Eyebrow>
      <ul class="mt-8 divide-y divide-stone border-t border-stone">
        {credentialList(siteConfig).map((item) => <li class="py-4 text-[length:var(--step-1)]">{item}</li>)}
      </ul>
      <p class="mt-6 text-ink-muted">NAICS 561730: Landscaping Services.</p>
      <div class="mt-8"><Button href="/contact">Request a quote or the capability statement</Button></div>
    </Container>
  </section>

  <ClosingCTA
    headline="Bidding a project?"
    body="Send the scope or the landscape plan. Alex reviews every request and sends you a quote."
  />
</PageLayout>
