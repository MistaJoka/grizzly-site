---
import { withBase } from '../../lib/url';
import type { GetStaticPaths } from 'astro';
import { getCollection, getEntry, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/primitives/Container.astro';
import Eyebrow from '../../components/primitives/Eyebrow.astro';
import ClosingCTA from '../../components/sections/ClosingCTA.astro';
import PageHero from '../../components/sections/PageHero.astro';
import { resolveImage } from '../../lib/images';
import { isDemo } from '../../../site.config';
import { DEMO_BEFORE_AFTER } from '../../lib/demo';
import { breadcrumbJsonLd } from '../../lib/schema';
import { canonical } from '../../lib/seo';

export const getStaticPaths: GetStaticPaths = async () => {
  const projects = await getCollection('projects');
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
};

const { project } = Astro.props;
const { Content } = await render(project);

// Real photos when the project has them; in demo mode the 40-tree job shows its illustrated pair.
const demoPair = isDemo() && project.id === 'forty-tree-installation' && !project.data.beforeImage && !project.data.afterImage;
const shots = demoPair
  ? { before: DEMO_BEFORE_AFTER.beforeImage, beforeAlt: DEMO_BEFORE_AFTER.beforeAlt, after: DEMO_BEFORE_AFTER.afterImage, afterAlt: DEMO_BEFORE_AFTER.afterAlt }
  : { before: project.data.beforeImage, beforeAlt: project.data.beforeAlt, after: project.data.afterImage, afterAlt: project.data.afterAlt };
const before = shots.before ? await resolveImage(shots.before) : undefined;
const after = shots.after ? await resolveImage(shots.after) : undefined;
const service = await getEntry('services', project.data.service);
if (!service) {
  throw new Error(`Project "${project.id}" references missing service "${project.data.service}".`);
}

// With no photos of its own yet, the project shows its service's image beside the scope.
const stand = !before && !after ? await resolveImage(service.data.heroImage) : undefined;

const url = canonical(`/work/${project.id}`, Astro.site);
const jsonLd = breadcrumbJsonLd([
  { name: 'Home', url: canonical('/', Astro.site) },
  { name: 'Work', url: canonical('/work', Astro.site) },
  { name: project.data.title, url },
]);

const shared = { widths: [480, 800, 1400], sizes: '(min-width: 768px) 45vw, 90vw', loading: 'lazy' as const };
---
<BaseLayout title={project.data.title} description={project.data.summary} jsonLd={jsonLd}>
  <PageHero title={project.data.title} eyebrow="Work" lede={project.data.summary}>
    <p slot="meta" class="mt-6 text-[length:var(--step-0)] text-ink-muted">
      {[project.data.town, project.data.year].filter(Boolean).join(' — ')}{(project.data.town || project.data.year) ? ' — ' : ''}
      <a href={withBase(`/services/${service.id}`)} class="text-moss underline underline-offset-4">{service.data.title}</a>
    </p>
  </PageHero>

  <div class="sheet z-10 overflow-hidden bg-paper">

  {(before || after) && (
    <section aria-label="Project photos" class="bg-paper-raised py-16">
      <Container>
        <div class="grid gap-6 md:grid-cols-2">
          {before && shots.beforeAlt && (
            <figure>
              <Image src={before} alt={shots.beforeAlt} {...shared} class="aspect-[4/3] w-full rounded-2xl object-cover" />
              <figcaption class="mt-3 text-[length:var(--step--1)] text-ink-muted">Before</figcaption>
            </figure>
          )}
          {after && shots.afterAlt && (
            <figure>
              <Image src={after} alt={shots.afterAlt} {...shared} class="aspect-[4/3] w-full rounded-2xl object-cover" />
              <figcaption class="mt-3 text-[length:var(--step--1)] text-ink-muted">After</figcaption>
            </figure>
          )}
        </div>
      </Container>
    </section>
  )}

  <section aria-label="Scope of work" class="bg-paper py-20 md:py-28">
    <Container>
      <div class={`grid items-start gap-14 ${stand ? 'md:grid-cols-[5fr_6fr] md:gap-20' : ''}`}>
        <div class={stand ? '' : 'max-w-[var(--container-text)]'}>
          <Eyebrow>Scope of work</Eyebrow>
          <ul class="mt-8 divide-y divide-stone border-t border-stone">
            {project.data.scope.map((item) => (
              <li class="py-5 text-[length:var(--step-2)] leading-snug">{item}</li>
            ))}
          </ul>
          <div class="mt-10 max-w-[52ch] text-[length:var(--step-1)] text-ink-muted"><Content /></div>
        </div>
        {stand && (
          <div class="grain relative overflow-hidden rounded-[var(--radius-media)] bg-stone shadow-[var(--shadow-panel)]">
            <Image src={stand} alt={service.data.heroAlt} {...shared} class="aspect-[4/3] w-full object-cover" />
          </div>
        )}
      </div>
    </Container>
  </section>

  <ClosingCTA
    headline="Tell us about your property."
    body="Describe the job and send a photo if you can. Alex reviews every request and sends you a quote."
  />
  </div>
</BaseLayout>
