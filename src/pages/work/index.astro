---
import { withBase } from '../../lib/url';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import PageLayout from '../../layouts/PageLayout.astro';
import Container from '../../components/primitives/Container.astro';
import ClosingCTA from '../../components/sections/ClosingCTA.astro';
import { resolveImage } from '../../lib/images';
import { breadcrumbJsonLd } from '../../lib/schema';
import { canonical } from '../../lib/seo';

const projects = await Promise.all(
  (await getCollection('projects'))
    .sort((a, b) => a.data.order - b.data.order)
    .map(async (project) => ({
      slug: project.id,
      data: project.data,
      image: project.data.afterImage ? await resolveImage(project.data.afterImage) : undefined,
    })),
);

const jsonLd = breadcrumbJsonLd([
  { name: 'Home', url: canonical('/', Astro.site) },
  { name: 'Work', url: canonical('/work', Astro.site) },
]);
---
<PageLayout
  title="Work we point to."
  eyebrow="Work"
  lede="Real projects, described only with details Alex has confirmed. More are added with photos as they are documented."
  description="Selected Grizzly Lawn Care projects in Miami-Dade, including a 40-tree installation with 25-gallon trees."
  jsonLd={jsonLd}
>
  <Container class="pb-24">
    <ul class="grid gap-14 md:grid-cols-2">
      {projects.map((project) => (
        <li class="reveal">
          <a href={withBase(`/work/${project.slug}`)} class="group block">
            {project.image && project.data.afterAlt && (
              <div class="overflow-hidden rounded-2xl bg-stone">
                <Image
                  src={project.image}
                  alt={project.data.afterAlt}
                  widths={[480, 800, 1200]}
                  sizes="(min-width: 768px) 45vw, 90vw"
                  loading="lazy"
                  class="aspect-[4/3] w-full object-cover transition-transform duration-[var(--dur-slow)] ease-[var(--ease-out)] group-hover:scale-[1.03]"
                />
              </div>
            )}
            <h2 class="mt-6 text-[length:var(--step-3)]">{project.data.title}</h2>
            <p class="mt-3 max-w-[44ch] text-ink-muted">{project.data.summary}</p>
            <p class="mt-4 text-moss underline underline-offset-4">Read more</p>
          </a>
        </li>
      ))}
    </ul>
  </Container>

  <ClosingCTA
    headline="Your property could be next."
    body="Describe the job and send a photo if you can. Alex reviews every request and sends you a quote."
  />
</PageLayout>
