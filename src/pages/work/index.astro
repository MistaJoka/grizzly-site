---
import { withBase } from '../../lib/url';
import { getCollection, getEntry } from 'astro:content';
import { Image } from 'astro:assets';
import PageLayout from '../../layouts/PageLayout.astro';
import Container from '../../components/primitives/Container.astro';
import ClosingCTA from '../../components/sections/ClosingCTA.astro';
import { resolveImage } from '../../lib/images';
import { breadcrumbJsonLd } from '../../lib/schema';
import { canonical } from '../../lib/seo';

const projects = await Promise.all(
  (await getCollection('projects'))
    .sort((a, b) => a.data.order - b.data.order)
    .map(async (project) => {
      // Until the project has its own photo, it borrows its service's image.
      const service = await getEntry('services', project.data.service);
      const own = project.data.afterImage && project.data.afterAlt;
      return {
        slug: project.id,
        data: project.data,
        image: await resolveImage(own ? project.data.afterImage! : service!.data.heroImage),
        alt: own ? project.data.afterAlt! : service!.data.heroAlt,
        serviceTitle: service!.data.title,
      };
    }),
);

const jsonLd = breadcrumbJsonLd([
  { name: 'Home', url: canonical('/', Astro.site) },
  { name: 'Work', url: canonical('/work', Astro.site) },
]);
---
<PageLayout
  title="Work we point to."
  eyebrow="Work"
  lede="Real projects, described only with details Alex has confirmed. More are added with photos as they are documented."
  description="Selected Grizzly Lawn Care projects in Miami-Dade, including a 40-tree installation with 25-gallon trees."
  jsonLd={jsonLd}
>
  <Container class="pb-24 md:pb-32">
    <ul class="space-y-24 md:space-y-32">
      {projects.map((project, i) => (
        <li class="reveal">
          <a href={withBase(`/work/${project.slug}`)} class="group grid items-center gap-12 md:grid-cols-[6fr_5fr] md:gap-16">
            <div class={`relative ${i % 2 ? 'md:order-2' : ''}`}>
              <div class="grain relative overflow-hidden rounded-[var(--radius-media)] bg-stone shadow-[var(--shadow-panel)]">
                <Image
                  src={project.image}
                  alt={project.alt}
                  widths={[480, 800, 1200]}
                  sizes="(min-width: 768px) 50vw, 90vw"
                  loading="lazy"
                  class="aspect-[4/3] w-full object-cover transition-transform duration-[var(--dur-slow)] ease-[var(--ease-out)] group-hover:scale-[1.04]"
                />
              </div>
              {project.data.scope.length > 0 && (
                <ul class="relative z-10 -mt-16 ml-6 rounded-[var(--radius-panel)] bg-canopy p-6 text-paper shadow-[var(--shadow-panel)] md:absolute md:-bottom-10 md:-right-10 md:m-0 md:w-[18rem]">
                  {project.data.scope.map((item) => <li class="py-1 text-[length:var(--step--1)] text-paper/85 first:font-[family-name:var(--font-display)] first:text-[length:var(--step-2)] first:leading-tight first:text-paper">{item}</li>)}
                </ul>
              )}
            </div>
            <div>
              <p class="text-[length:var(--step--1)] font-semibold text-moss">{project.serviceTitle}</p>
              <h2 class="mt-3 text-[length:var(--step-5)] leading-[1]">{project.data.title}</h2>
              <p class="mt-6 max-w-[44ch] text-[length:var(--step-1)] text-ink-muted">{project.data.summary}</p>
              <p class="mt-8 inline-flex rounded-full border border-ink/25 px-6 py-3 font-semibold transition-colors duration-[var(--dur-fast)] group-hover:border-ink">See the project</p>
            </div>
          </a>
        </li>
      ))}
    </ul>
  </Container>

  <ClosingCTA
    headline="Your property could be next."
    body="Describe the job and send a photo if you can. Alex reviews every request and sends you a quote."
  />
</PageLayout>
