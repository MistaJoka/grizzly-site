---
import { withBase } from '../../lib/url';
import type { GetStaticPaths } from 'astro';
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/primitives/Container.astro';
import Eyebrow from '../../components/primitives/Eyebrow.astro';
import ClosingCTA from '../../components/sections/ClosingCTA.astro';
import PageHero from '../../components/sections/PageHero.astro';
import { gridSpans } from '../../lib/grid';
import { breadcrumbJsonLd, serviceJsonLd } from '../../lib/schema';
import { canonical } from '../../lib/seo';

export const getStaticPaths: GetStaticPaths = async () => {
  const areas = await getCollection('areas');
  return areas.map((area) => ({ params: { slug: area.id }, props: { area } }));
};

const { area } = Astro.props;
const url = canonical(`/areas/${area.id}`, Astro.site);

const allServices = await getCollection('services');
const services = area.data.services
  .map((slug) => allServices.find((service) => service.id === slug))
  .filter((service): service is NonNullable<typeof service> => Boolean(service));

const spans = gridSpans(services.length);

const jsonLd = [
  serviceJsonLd({
    name: `Lawn care and landscaping in ${area.data.town}, ${area.data.state}`,
    description: area.data.summary,
    url,
    areaServed: [area.data.town],
  }),
  breadcrumbJsonLd([
    { name: 'Home', url: canonical('/', Astro.site) },
    { name: area.data.town, url },
  ]),
];
---
<BaseLayout title={area.data.headline} description={area.data.summary} jsonLd={jsonLd}>
  <PageHero title={area.data.headline} eyebrow="Service area" lede={area.data.summary} />

  <div class="sheet z-10 overflow-hidden bg-paper-raised">
  <section aria-label="Local conditions" class="bg-paper-raised py-20 md:py-24">
    <Container>
      <div class="grid items-start gap-12 md:grid-cols-[7fr_4fr] md:gap-16">
        <div>
          <Eyebrow>What {area.data.town} properties need</Eyebrow>
          <p class="mt-6 max-w-[60ch] text-[length:var(--step-1)] leading-relaxed">{area.data.localNote}</p>
        </div>
        {area.data.neighborhoods.length > 0 && (
          <section aria-label="Neighborhoods served" class="relative overflow-hidden rounded-[var(--radius-panel)] bg-canopy p-7 text-paper shadow-[var(--shadow-panel)] md:p-8">
            <div aria-hidden="true" class="stripes absolute inset-x-0 top-0 h-2 opacity-90"></div>
            <h2 class="text-[length:var(--step-2)] leading-tight">Neighborhoods in {area.data.town}</h2>
            <ul class="mt-5 space-y-2.5">
              {area.data.neighborhoods.map((neighborhood) => (
                <li class="flex items-center gap-3 text-paper/85">
                  <span aria-hidden="true" class="h-1.5 w-1.5 rounded-full bg-blade"></span>{neighborhood}
                </li>
              ))}
            </ul>
          </section>
        )}
      </div>
    </Container>
  </section>

  <section aria-label="Services offered here" class="bg-paper py-20 md:py-24">
    <Container>
      <Eyebrow>What we do in {area.data.town}</Eyebrow>
      <ul class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-6 lg:gap-8">
        {services.map((service, i) => (
          <li class={`reveal ${spans[i]} ${i === services.length - 1 && services.length % 2 ? 'md:max-lg:col-span-2' : ''}`}>
            <a href={withBase(`/services/${service.id}`)} class="group block h-full rounded-[var(--radius-panel)] bg-paper-raised p-7 shadow-[var(--shadow-panel)] transition-transform duration-[var(--dur-base)] ease-[var(--ease-out)] hover:-translate-y-1">
              <h2 class="text-[length:var(--step-2)] leading-tight group-hover:text-moss">{service.data.title}</h2>
              <p class="mt-3 text-ink-muted">{service.data.summary}</p>
            </a>
          </li>
        ))}
      </ul>
    </Container>
  </section>

  <ClosingCTA
    headline={`Need work done in ${area.data.town}?`}
    body="Describe the job and send a photo if you can. Alex reviews every request and sends you a quote."
  />
  </div>
</BaseLayout>
