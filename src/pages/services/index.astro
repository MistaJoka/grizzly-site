---
import { withBase } from '../../lib/url';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import PageLayout from '../../layouts/PageLayout.astro';
import Container from '../../components/primitives/Container.astro';
import ClosingCTA from '../../components/sections/ClosingCTA.astro';
import { gridSpans } from '../../lib/grid';
import { resolveImage } from '../../lib/images';
import { breadcrumbJsonLd } from '../../lib/schema';
import { canonical } from '../../lib/seo';

const services = await Promise.all(
  (await getCollection('services'))
    .sort((a, b) => a.data.order - b.data.order)
    .map(async (service) => ({
      slug: service.id,
      data: service.data,
      image: await resolveImage(service.data.heroImage),
    })),
);

const spans = gridSpans(services.length);

const jsonLd = breadcrumbJsonLd([
  { name: 'Home', url: canonical('/', Astro.site) },
  { name: 'Services', url: canonical('/services', Astro.site) },
]);
---
<PageLayout
  title="Five services, with the owner on every job."
  eyebrow="Services"
  lede="Lawn care, trimming, mulching, pressure washing, and tree and plant installs across Miami-Dade, quoted and managed by Alex Bermudez."
  description="Lawn mowing and maintenance, bush and hedge trimming, mulching, tree and plant installation, and pressure washing in Miami-Dade."
  jsonLd={jsonLd}
>
  <Container class="pb-24 md:pb-32">
    <ul class="grid gap-x-8 gap-y-14 md:grid-cols-2 lg:grid-cols-6">
      {services.map((service, i) => (
        <li class={`reveal ${spans[i]} ${i === services.length - 1 && services.length % 2 ? 'md:max-lg:col-span-2' : ''}`}>
          <a href={withBase(`/services/${service.slug}`)} class="group flex h-full flex-col">
            <div class="grain relative overflow-hidden rounded-[var(--radius-media)] bg-stone">
              <Image
                src={service.image}
                alt={service.data.heroAlt}
                widths={[480, 800, 1200]}
                sizes={spans[i] === 'lg:col-span-2' ? '(min-width: 1024px) 30vw, (min-width: 768px) 45vw, 90vw' : '(min-width: 768px) 45vw, 90vw'}
                loading="lazy"
                class={`w-full object-cover transition-transform duration-[var(--dur-slow)] ease-[var(--ease-out)] group-hover:scale-[1.04] ${spans[i] === 'lg:col-span-2' ? 'aspect-[4/3]' : 'aspect-[16/10]'}`}
              />
            </div>
            <div class="relative z-10 -mt-12 ml-4 mr-6 flex-1 rounded-[var(--radius-panel)] bg-paper-raised px-6 py-6 shadow-[var(--shadow-panel)] transition-transform duration-[var(--dur-base)] ease-[var(--ease-out)] group-hover:-translate-y-1">
              <h2 class="text-[length:var(--step-3)] leading-tight">{service.data.title}</h2>
              <p class="mt-3 max-w-[46ch] text-[length:var(--step--1)] leading-relaxed text-ink-muted">{service.data.summary}</p>
            </div>
          </a>
        </li>
      ))}
    </ul>
  </Container>

  <ClosingCTA
    headline="Not sure which one you need?"
    body="Most properties need two or three of these together. Describe the property and Alex will tell you where to start."
  />
</PageLayout>
