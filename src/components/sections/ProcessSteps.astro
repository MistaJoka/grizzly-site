---
import { frond } from '../../lib/art.mjs';

interface Props { steps: { title: string; body: string }[] }
const { steps } = Astro.props;
const shade = frond(1260, -40, 140, 900, 160, { leaflets: 34, leafLen: 250, leafWidth: 16, spread: 55 });
---
<section aria-label="How it works" class="sheet z-20 overflow-hidden bg-canopy py-24 text-paper md:py-36">
  <svg aria-hidden="true" focusable="false" viewBox="0 0 1200 800" preserveAspectRatio="xMaxYMin slice" class="pointer-events-none absolute inset-0 h-full w-full">
    <path d={shade} fill="var(--canopy-deep)" />
  </svg>

  <div class="relative mx-auto w-full max-w-[var(--container)] px-6 md:px-10">
    <h2 class="max-w-[15ch] text-[length:var(--step-5)]">Three steps, and you always talk to Alex.</h2>

    <!-- A staircase: each step sits a little lower and overlaps the one before. -->
    <ol class="mt-16 grid gap-6 md:mt-20 md:grid-cols-3 md:gap-0">
      {steps.map((step, index) => (
        <li
          class="reveal relative rounded-[var(--radius-panel)] border border-paper/10 bg-moss-deep/80 p-7 shadow-[var(--shadow-panel)] backdrop-blur-sm md:p-9"
          style={`--i:${index}`}
        >
          <span class="block font-[family-name:var(--font-display)] text-[length:var(--step-6)] leading-none text-blade">{index + 1}</span>
          <h3 class="mt-6 text-[length:var(--step-2)]">{step.title}</h3>
          <p class="mt-3 max-w-[34ch] text-paper/75">{step.body}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  @media (min-width: 768px) {
    li { margin-top: calc(var(--i) * 4.5rem); margin-left: calc(var(--i) * -1.25rem); z-index: calc(var(--i) + 1); }
  }
</style>
