---
import { withBase } from '../../lib/url';
import { Image } from 'astro:assets';
import { resolveImage } from '../../lib/images';

interface ServiceCard {
  slug: string;
  title: string;
  summary: string;
  imagePath: string;
  imageAlt: string;
}
interface Props { services: ServiceCard[] }
const { services } = Astro.props;
const cards = await Promise.all(
  services.map(async (service) => ({ ...service, image: await resolveImage(service.imagePath) })),
);
// An uneven grid on wide screens: the first service anchors the left column,
// the rest pair up beside and below it.
const spans = [
  'lg:col-span-7 lg:row-span-2',
  'lg:col-span-5',
  'lg:col-span-5',
  'lg:col-span-6',
  'lg:col-span-6',
];
---
<section aria-label="What we do" class="sheet z-10 bg-paper-raised pb-24 pt-16 md:pb-32 md:pt-24">
  <div class="mx-auto w-full max-w-[var(--container)] px-6 md:px-10">
    <h2 class="max-w-[16ch] text-[length:var(--step-5)]">Five services, with the owner on every job.</h2>
  </div>

  <ul
    class="mt-12 flex snap-x snap-mandatory gap-5 overflow-x-auto px-6 pb-6 md:mt-16 lg:mx-auto lg:grid lg:max-w-[var(--container)] lg:grid-cols-12 lg:gap-x-8 lg:gap-y-10 lg:overflow-visible lg:px-10"
  >
    {cards.map((card, index) => (
      <li class={`reveal w-[78vw] flex-none snap-start sm:w-[22rem] lg:w-auto ${spans[index] ?? 'lg:col-span-6'}`}>
        <a href={withBase(`/services/${card.slug}`)} class="group flex h-full flex-col">
          <div class="grain relative flex-1 overflow-hidden rounded-[var(--radius-media)] bg-stone">
            <Image
              src={card.image}
              alt={card.imageAlt}
              widths={[480, 800, 1200, 1600]}
              sizes="(min-width: 1024px) 50vw, 78vw"
              loading="lazy"
              class={`h-full w-full object-cover transition-transform duration-[var(--dur-slow)] ease-[var(--ease-out)] group-hover:scale-[1.04] ${index === 0 ? 'aspect-[4/5] lg:aspect-auto' : 'aspect-[4/5] lg:aspect-[16/10]'}`}
            />
          </div>
          <div class="relative z-10 -mt-14 ml-4 mr-8 rounded-[var(--radius-panel)] bg-paper-raised px-5 py-5 shadow-[var(--shadow-panel)] transition-transform duration-[var(--dur-base)] ease-[var(--ease-out)] group-hover:-translate-y-1 md:ml-6 md:px-6">
            <h3 class="text-[length:var(--step-2)] leading-tight">{card.title}</h3>
            <p class="mt-2 text-[length:var(--step--1)] leading-relaxed text-ink-muted">{card.summary}</p>
          </div>
        </a>
      </li>
    ))}
  </ul>
</section>
