---
import { withBase } from '../../lib/url';

interface Props { areas: { slug: string; town: string; state: string }[] }
const { areas } = Astro.props;
---
<section aria-label="Service area" class="sheet z-50 bg-paper-raised py-24 md:py-32">
  <div class="mx-auto grid w-full max-w-[var(--container)] gap-12 px-6 md:grid-cols-[2fr_3fr] md:px-10">
    <div>
      <h2 class="max-w-[12ch] text-[length:var(--step-5)]">Serving Miami-Dade County.</h2>
      <p class="mt-6 max-w-[34ch] text-ink-muted">Homes, HOAs and commercial properties in these cities and the neighborhoods around them.</p>
    </div>

    <ul class="border-t border-ink/15">
      {areas.map((area) => (
        <li class="border-b border-ink/15">
          <a
            href={withBase(`/areas/${area.slug}`)}
            class="group relative flex items-baseline justify-between gap-6 overflow-hidden py-5"
          >
            <span aria-hidden="true" class="stripes absolute inset-y-0 left-0 w-full origin-left scale-x-0 opacity-30 transition-transform duration-[var(--dur-base)] ease-[var(--ease-out)] group-hover:scale-x-100 group-focus-visible:scale-x-100"></span>
            <span class="relative font-[family-name:var(--font-display)] text-[length:var(--step-4)] leading-none transition-transform duration-[var(--dur-base)] ease-[var(--ease-out)] group-hover:translate-x-3">{area.town}</span>
            <span class="relative text-[length:var(--step--1)] font-semibold text-ink-muted">{area.state}</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>
